# ===== General =====
ENVIRONMENT=development
DEBUG=true

# ===== LLM Provider =====
# Switch between "groq" and "openai" without changing any code
LLM_PROVIDER=groq

# --- Groq (default, free/fast inference) ---
GROQ_API_KEY=your_groq_api_key_here
# NOTE: llama-3.3-70b-versatile was deprecated by Groq on 2026-06-17.
# openai/gpt-oss-120b (below) is Groq's recommended replacement.
GROQ_MODEL=openai/gpt-oss-120b

# --- OpenAI (optional, future support) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_STREAMING=true

# ===== Embeddings =====
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ===== RAG Tuning =====
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
SIMILARITY_THRESHOLD=0.2

# ===== Uploads =====
MAX_UPLOAD_SIZE_MB=20

# ===== CORS =====
# Comma-separated list is supported, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://your-deployed-frontend.com
